<?php

// Hàm xếp loại sinh viên
function xepLoai($diem)
{
    if ($diem >= 8) {
        return "Giỏi";
    } elseif ($diem >= 6.5) {
        return "Khá";
    } elseif ($diem >= 5) {
        return "Trung bình";
    } else {
        return "Chưa đạt";
    }
}

$danhSachSinhVien = [];

if (isset($_POST["hienThi"])) {

    for ($i = 1; $i <= 3; $i++) {

        $ten = $_POST["ten$i"];
        $diem = $_POST["diem$i"];

        $danhSachSinhVien[] = [
            "ten" => $ten,
            "diem" => $diem,
            "xepLoai" => xepLoai($diem)
        ];
    }
}

?>

