<?php

session_start();


// Nếu chưa có danh sách sinh viên thì tạo mảng rỗng
if (!isset($_SESSION["danhSachSinhVien"])) {
    $_SESSION["danhSachSinhVien"] = [];
}


// Hàm xếp loại
function xepLoai($diem)
{
    if ($diem >= 8) {
        return "Giỏi";
    } elseif ($diem >= 6.5) {
        return "Khá";
    } elseif ($diem >= 5) {
        return "Trung bình";
    } else {
        return "Chưa đạt";
    }
}


// Khi nhấn nút Thêm sinh viên
if (isset($_POST["themSinhVien"])) {

    $ten = trim($_POST["ten"]);
    $diem = $_POST["diem"];

    // Tạo thông tin sinh viên
    $sinhVien = [
        "ten" => $ten,
        "diem" => $diem,
        "xepLoai" => xepLoai($diem)
    ];

    // Thêm sinh viên vào mảng
    $_SESSION["danhSachSinhVien"][] = $sinhVien;

    // Chuyển hướng lại trang
    // để form trở về trạng thái trống
    header("Location: bai3.php");
    exit();
}


// Khi nhấn nút Xóa tất cả
if (isset($_POST["xoaTatCa"])) {

    $_SESSION["danhSachSinhVien"] = [];

    header("Location: bai3.php");
    exit();
}

?>

